# Local demonstration only. Generate independent random secrets for deployment.
DB_USER=agnos
DB_PASSWORD=agnos_local_only
DB_NAME=agnos
DB_PORT=5432
HTTP_PORT=8080
JWT_SECRET=local-demo-jwt-secret-change-before-deploy-123456
STAFF_PROVISIONING_KEY=local-demo-provisioning-key-change-before-deploy-123456
JWT_TTL=1h
HIS_TIMEOUT=5s
# Demo: docker compose --profile demo up --build -d
HOSPITAL_A_API_URL=http://mock-his:8090/a
